variable "rarity" {
	source "pdc" key="rarity" type="string" default="common"
	lookup {
		"common" "<gray>Common"
		"uncommon" "<green>Uncommon"
		"rare" "<blue>Rare"
		"epic" "<light_purple><bold>Epic"
		"legendary" "<gold><bold>Legendary"
	}
	fallback "<gray>Unknown"
}

variable "item_level" {
	source "pdc" key="item_level" type="int" default=1
}
